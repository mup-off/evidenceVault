# Copy to .env and adjust. Passwords must match docker-compose.yml
# (or the EV_*_PASSWORD variables you set for it).

PORT=4000

# The API connects as ev_app, which has only the privileges the migrations grant.
DATABASE_URL=postgres://ev_app:app_dev_only@localhost:5434/evidencevault
# Migrations run as ev_owner, which owns the schema.
MIGRATION_DATABASE_URL=postgres://ev_owner:owner_dev_only@localhost:5434/evidencevault

# Separate database used by `npm test`; it is wiped on every test run.
TEST_DATABASE_URL=postgres://ev_app:app_dev_only@localhost:5434/evidencevault_test
TEST_MIGRATION_DATABASE_URL=postgres://ev_owner:owner_dev_only@localhost:5434/evidencevault_test

# Created by `npm run keygen`. Back it up separately from the database.
SECRETS_PATH=data/secrets.json

# Encrypted evidence files. Back up together with the database.
EVIDENCE_DIR=data/evidence
MAX_UPLOAD_MB=100

JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
LOCKOUT_MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
