{
  "name": "evidencevault-backend",
  "version": "0.1.0",
  "private": true,
  "description": "EvidenceVault Rwanda API: digital evidence registration, integrity checks and chain of custody",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "keygen": "node scripts/keygen.js",
    "migrate": "node-pg-migrate up -m db/migrations -d MIGRATION_DATABASE_URL --envPath .env",
    "migrate:down": "node-pg-migrate down -m db/migrations -d MIGRATION_DATABASE_URL --envPath .env",
    "migrate:create": "node-pg-migrate create -m db/migrations -j sql",
    "seed": "node scripts/seed.js",
    "tamper:file": "node scripts/tamper/file.js",
    "tamper:log": "node scripts/tamper/log.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.2"
  }
}
